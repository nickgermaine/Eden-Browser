set(EDEN_GOCRYPTFS_VERSION "2.6.1")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|amd64|AMD64")
    set(EDEN_GOCRYPTFS_ARCH "amd64")
    set(EDEN_GOCRYPTFS_SHA256 "49b8c0eb0f6373b6ac99c394a52909d8478e74c08d0961527c1162967cc28c44")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
    set(EDEN_GOCRYPTFS_ARCH "arm64")
    set(EDEN_GOCRYPTFS_SHA256 "64576d550ab8af3f1dc729e93779540c5ecc00967d0185aae51a29a3755d86d0")
else()
    message(FATAL_ERROR "Encrypted engine storage requires a supported Linux gocryptfs build")
endif()
set(EDEN_GOCRYPTFS_DIRECTORY "${CMAKE_SOURCE_DIR}/third_party/gocryptfs/${EDEN_GOCRYPTFS_VERSION}-${EDEN_GOCRYPTFS_ARCH}")
set(EDEN_GOCRYPTFS_LOCAL_ARCHIVE "" CACHE FILEPATH "Use the pinned gocryptfs archive from a local file")
if(EDEN_GOCRYPTFS_LOCAL_ARCHIVE)
    set(EDEN_GOCRYPTFS_ARCHIVE "${EDEN_GOCRYPTFS_LOCAL_ARCHIVE}")
else()
    set(EDEN_GOCRYPTFS_ARCHIVE "${CMAKE_BINARY_DIR}/gocryptfs-${EDEN_GOCRYPTFS_VERSION}-${EDEN_GOCRYPTFS_ARCH}.tar.gz")
    if(NOT EXISTS "${EDEN_GOCRYPTFS_ARCHIVE}")
        file(DOWNLOAD "https://github.com/rfjakob/gocryptfs/releases/download/v${EDEN_GOCRYPTFS_VERSION}/gocryptfs_v${EDEN_GOCRYPTFS_VERSION}_linux-static_${EDEN_GOCRYPTFS_ARCH}.tar.gz"
            "${EDEN_GOCRYPTFS_ARCHIVE}" EXPECTED_HASH "SHA256=${EDEN_GOCRYPTFS_SHA256}" TLS_VERIFY ON)
    endif()
endif()
file(SHA256 "${EDEN_GOCRYPTFS_ARCHIVE}" EDEN_GOCRYPTFS_ACTUAL_HASH)
if(NOT EDEN_GOCRYPTFS_ACTUAL_HASH STREQUAL EDEN_GOCRYPTFS_SHA256)
    message(FATAL_ERROR "The gocryptfs archive does not match the pinned digest")
endif()
file(MAKE_DIRECTORY "${EDEN_GOCRYPTFS_DIRECTORY}")
file(ARCHIVE_EXTRACT INPUT "${EDEN_GOCRYPTFS_ARCHIVE}" DESTINATION "${EDEN_GOCRYPTFS_DIRECTORY}")
configure_file("${EDEN_GOCRYPTFS_DIRECTORY}/gocryptfs" "${CMAKE_BINARY_DIR}/eden-gocryptfs" COPYONLY)
install(PROGRAMS "${CMAKE_BINARY_DIR}/eden-gocryptfs" DESTINATION bin)

install(FILES "${CMAKE_SOURCE_DIR}/resources/licenses/gocryptfs.txt" DESTINATION share/licenses/eden-browser RENAME gocryptfs-LICENSE)
