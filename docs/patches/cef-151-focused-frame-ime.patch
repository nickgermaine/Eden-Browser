+void CefRenderWidgetHostViewOSR::OnSelectionBoundsChanged(
+    content::TextInputManager* text_input_manager,
+    content::RenderWidgetHostViewBase* updated_view) {
+  const auto* state = text_input_manager->GetTextInputState();
+  if (!browser_impl_ || !state || state->type == ui::TEXT_INPUT_TYPE_NONE ||
+      GetFocusedTextInputWidget() != text_input_manager->GetActiveWidget()) {
+    return;
+  }
+  const auto* selection = text_input_manager->GetSelectionRegion();
+  if (!selection) {
+    return;
+  }
+  const auto& focus = selection->focus;
+  if (focus.edge_start() == focus.edge_end()) {
+    return;
+  }
+  gfx::Rect caret = gfx::BoundingRect(focus.edge_start_rounded(), focus.edge_end_rounded());
+  caret.set_width(std::max(1, caret.width()));
+  caret.set_height(std::max(1, caret.height()));
+  CefRefPtr<CefRenderHandler> handler = browser_impl_->GetClient()->GetRenderHandler();
+  CHECK(handler);
+  handler->OnImeCompositionRangeChanged(
+      browser_impl_->GetBrowser(), CefRange::InvalidRange(),
+      {CefRect(caret.x(), caret.y(), caret.width(), caret.height())});
+}
