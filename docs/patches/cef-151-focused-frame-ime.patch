+void CefRenderWidgetHostViewOSR::OnImeCompositionRangeChanged(
+    content::TextInputManager* text_input_manager,
+    content::RenderWidgetHostViewBase* updated_view,
+    bool character_bounds_changed) {
+  if (updated_view == this || !browser_impl_ ||
+      text_input_manager->GetActiveWidget() != updated_view->host() ||
+      GetFocusedTextInputWidget() != updated_view->host()) {
+    return;
+  }
+  const auto* composition = text_input_manager->GetCompositionRangeInfo();
+  if (!composition) {
+    return;
+  }
+  CefRenderHandler::RectList bounds;
+  if (character_bounds_changed) {
+    bounds.reserve(composition->character_bounds.size());
+    for (const auto& rect : composition->character_bounds) {
+      bounds.emplace_back(rect.x(), rect.y(), rect.width(), rect.height());
+    }
+  }
+  CefRefPtr<CefRenderHandler> handler = browser_impl_->GetClient()->GetRenderHandler();
+  CHECK(handler);
+  handler->OnImeCompositionRangeChanged(
+      browser_impl_->GetBrowser(),
+      CefRange(composition->range.start(), composition->range.end()), bounds);
+}
